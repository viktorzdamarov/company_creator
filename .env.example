# DEMO mode: fake Keitaro with 5 invented offers and 2 demo campaigns; KEITARO_URL / KEITARO_API_KEY are not needed.
# State is kept in DEMO_STATE_FILE (delete it to start over).
DEMO_MODE=false
DEMO_STATE_FILE=demo_state.json

# Keitaro tracker
KEITARO_URL=https://your-keitaro-host.example
KEITARO_API_KEY=put-your-api-key-here

# Defaults applied to every created campaign (names or numeric IDs as seen in Keitaro)
KEITARO_DEFAULT_DOMAIN=kylovoa.com
KEITARO_DEFAULT_GROUP=FORTESTS
KEITARO_DEFAULT_SOURCE=FORTESTS

# Database (SQLite by default; Postgres: postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///./adrobot.db

LOG_LEVEL=INFO
